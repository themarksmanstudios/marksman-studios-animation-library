# Optional absolute directory for the local JSON database.
# Defaults to ./data. Keep this on persistent storage.
# ANIMATION_DATA_DIR=C:/path/to/data

# Optional Python executable for XLSX imports.
# PYTHON_EXECUTABLE=C:/Python313/python.exe

# Blender production pipeline. Set this to Blender's executable to enable background jobs.
# BLENDER_EXECUTABLE=C:/Program Files/Blender Foundation/Blender 5.0/blender.exe
# ANIMATION_PRODUCTION_DIR=C:/Marksman/AnimationProduction
# BLENDER_PREVIEW_RESOLUTION=480
